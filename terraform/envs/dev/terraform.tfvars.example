# Example variable values for the dev environment

# AWS region to deploy resources
aws_region = "us-west-2"

# S3 bucket for storing Terraform state
state_bucket = "my-terraform-state-bucket"

# EKS cluster name
eks_cluster_name = "dev-eks-cluster"

# IAM role ARN for the EKS control plane (update with your actual role ARN)
eks_cluster_role_arn = "arn:aws:iam::123456789012:role/EKSClusterRole"

# IAM role ARN for the EKS worker nodes (update with your actual role ARN)
eks_node_role_arn = "arn:aws:iam::123456789012:role/EKSNodeRole"

# List of subnet IDs for EKS and ELB (update with your actual subnet IDs)
eks_subnet_ids = [
  "subnet-abc12345",
  "subnet-def67890"
]

# EC2 instance type for EKS worker nodes
eks_node_instance_type = "t3.medium" 