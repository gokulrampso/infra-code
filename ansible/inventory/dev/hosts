# Ansible inventory for dev environment
# Define the worker nodes that will have Kubernetes installed

[workers]
# Replace these with your actual EC2 public IPs or DNS names
worker1 ansible_host=1.2.3.4
worker2 ansible_host=5.6.7.8
worker3 ansible_host=9.10.11.12

[all:vars]
# SSH user for the EC2 instances (e.g., 'ubuntu' for Ubuntu AMIs)
ansible_user=ubuntu
# Path to your SSH private key for connecting to the instances
ansible_ssh_private_key_file=~/.ssh/your-key.pem 